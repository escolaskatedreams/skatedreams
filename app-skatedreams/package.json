{
  "name": "app-skatedreams",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --tsconfig tsconfig.json --env-file=.env.local scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "TEST_DATABASE_URL=postgres://skatedreams:skatedreams_dev@localhost:5433/skatedreams_test vitest run tests/unit/lib/reports",
    "test:e2e": "playwright test"
  },
  "dependencies": {
