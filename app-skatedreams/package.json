    "@fullcalendar/timegrid": "^6.1.20",
    "autoprefixer": "^10.5.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "googleapis": "^171.4.0",
    "iron-session": "^8.0.4",
    "next": "^15.5.18",
    "pg": "^8.20.0",
    "postcss": "^8.5.14",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
