docs/brand/assets/**/*.jpg
docs/brand/assets/**/*.jpeg
docs/brand/assets/**/*.webp
docs/brand/assets/**/*.svg
docs/brand/assets/**/*.pdf
docs/brand/assets/**/*.mp4
docs/brand/assets/**/*.mov
docs/brand/assets/**/*.gif
apps-script-webhook.json
